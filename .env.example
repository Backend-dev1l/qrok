# Локальные переменные окружения qrok.
# Скопируйте в .env (git его игнорирует) и поменяйте нужные значения:
#   cp .env.example .env
#
# Приоритет конфига сервера: дефолты в коде -> YAML -> env (QROK_*) -> флаги.
# В будущем вместо .env можно использовать Doppler без правок кода:
#   doppler run -- make run-server

# --- Креды dev-инфраструктуры (docker-compose) ---
# ВАЖНО: Postgres применяет креды только при первой инициализации volume.
# После их смены выполните: make compose-nuke && make compose-up
POSTGRES_USER=qrok
POSTGRES_PASSWORD=qrok
POSTGRES_DB=qrok

MINIO_ROOT_USER=qrok
MINIO_ROOT_PASSWORD=qrok-secret

# --- Конфиг qrok server (перекрывает YAML) ---
#QROK_CONFIG=qrok.yaml
#QROK_LOG_LEVEL=debug
#QROK_LOG_FORMAT=pretty
#QROK_HTTP_ADDR=:8080
#QROK_GRPC_ADDR=:9090
#QROK_GATEWAY_TLS=true
#QROK_GATEWAY_TLS_SERVER_NAME=gateway.example.com
#QROK_GATEWAY_TLS_CA_FILE=
#QROK_POSTGRES_DSN=postgres://qrok:qrok@localhost:5432/qrok?sslmode=disable
#QROK_REDIS_ADDR=localhost:6379
#QROK_REDIS_PASSWORD=
#QROK_S3_ENDPOINT=localhost:9000
#QROK_S3_BUCKET=qrok-payloads
#QROK_S3_ACCESS_KEY=qrok
#QROK_S3_SECRET_KEY=qrok-secret
#QROK_PAYLOAD_THRESHOLD_BYTES=262144
#QROK_MAX_PAYLOAD_BYTES=1048576
#QROK_KAFKA_TLS=true
#QROK_KAFKA_TLS_SERVER_NAME=kafka.example.com
#QROK_KAFKA_TLS_CA_FILE=
#QROK_KAFKA_SASL_MECHANISM=scram-sha-256
#QROK_KAFKA_SASL_USERNAME=
#QROK_KAFKA_SASL_PASSWORD=

# --- Тесты ---
#TEST_POSTGRES_DSN=postgres://qrok:qrok@localhost:5432/qrok?sslmode=disable
#TEST_KAFKA_BROKER=localhost:9092

# --- Makefile ---
#DB_DSN=postgres://qrok:qrok@localhost:5432/qrok?sslmode=disable
